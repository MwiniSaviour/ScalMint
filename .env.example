# Database — SQLite for local, Postgres for production (Neon/Supabase)
DATABASE_URL="file:./dev.db"

# Auth — 32+ char random. Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-32-char-secret-change-in-production"

# Paystack — Ghana (Registered Business required for Transfers)
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."
# Allowed IPs for webhook — Paystack egress (verify via x-paystack-signature)
PAYSTACK_WEBHOOK_SECRET=""

# App URLs — change dns to affiliate.scalmint.com in production
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_AFFILIATE_URL="http://localhost:3000/affiliate"

# Ghana thresholds (pesewas)
MIN_PAYOUT_MOMO_PESEWAS=5000
MIN_PAYOUT_BANK_PESEWAS=10000
