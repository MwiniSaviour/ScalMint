# PostgreSQL (VPS: smartsos-db-1 exposes 127.0.0.1:5433)
DATABASE_URL="postgresql://scalmint_app:password@127.0.0.1:5433/scalmint?schema=public"

# Auth — 32+ char random. Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-32-char-secret-change-in-production"

# Paystack — Ghana (Registered Business required for Transfers)
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."
# Allowed IPs for webhook — Paystack egress (verify via x-paystack-signature)
PAYSTACK_WEBHOOK_SECRET=""

# App URLs — production hosts: scalmint.com, affiliate.scalmint.com, admin.scalmint.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_AFFILIATE_URL="http://localhost:3000/affiliate"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000/admin"

# Operator console bootstrap (run once: npm run ops:bootstrap)
# No default password exists. Prefer a one-time reset token printed by bootstrap.
ADMIN_EMAIL="ops@scalmint.com"
ADMIN_NAME="ScalMint Ops"
# ADMIN_PASSWORD=  # optional one-time seed only; remove from the environment after bootstrap

# Ghana thresholds (pesewas)
MIN_PAYOUT_MOMO_PESEWAS=5000
MIN_PAYOUT_BANK_PESEWAS=10000
