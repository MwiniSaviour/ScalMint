{
  "crons": [{ "path": "/api/affiliate/cron/approve", "schedule": "0 2 * * *" }],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "affiliate.scalmint.com" }],
      "destination": "/affiliate"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.scalmint.com" }],
      "destination": "/admin"
    }
  ]
}
